# ---------------------------------------------------------------------------
# Run `python cli.py setup --username <your_sleeper_username>` to fill these in.
# ---------------------------------------------------------------------------

# Your Sleeper username, used to identify which roster in the league is yours.
SLEEPER_USERNAME=

# The league to analyze. `cli.py setup` prints this for every league you are in.
SLEEPER_LEAGUE_ID=

# Optional. Leave blank and the toolkit finds the league's draft automatically.
SLEEPER_DRAFT_ID=

# Optional. Blank means "whatever season Sleeper says is current".
SLEEPER_SEASON=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=./data/sleeper.db

# Cache lifetimes. Sleeper asks that the 15 MB player index be pulled at most
# once a day. Projections update through the week, so 6 hours is a good balance.
PLAYER_CACHE_HOURS=24
PROJECTION_CACHE_HOURS=6
LEAGUE_CACHE_MINUTES=15

# ---------------------------------------------------------------------------
# Analysis tuning
# ---------------------------------------------------------------------------
# How many weeks ahead "rest of season" value looks. Shorter favors win-now
# moves, longer favors dynasty and keeper thinking.
ROS_HORIZON_WEEKS=6
REGULAR_SEASON_WEEKS=17

# ---------------------------------------------------------------------------
# Notifications for the scheduled digest. Set either, both, or neither.
# ---------------------------------------------------------------------------
# Any endpoint that accepts {"title": ..., "text": ...} as JSON.
DIGEST_WEBHOOK_URL=

# ntfy.sh topic, which the phone app subscribes to. Pick an unguessable name.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
