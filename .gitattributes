# Normalize to LF in the repository; check out native on Windows.
* text=auto

# These are consumed by the Linux container. CRLF breaks the shebang and cron
# parsing, so they must stay LF on disk regardless of platform.
scripts/entrypoint.sh text eol=lf
scripts/crontab       text eol=lf
Dockerfile            text eol=lf

# PowerShell is happiest with CRLF.
*.ps1 text eol=crlf
